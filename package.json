{
  "name": "care-giver",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "next:dev": "npm --prefix web run dev",
    "all": "run-p android next:dev",
    "all-ios": "run-p ios next:dev",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:clear-recipient": "supabase db query --local --file supabase/clear-recipient.sql",
    "supabase:seed-remote": "supabase db query --linked --file supabase/seed.sql",
    "supabase:reset-all-local": "node scripts/reset-all-data.js --local",
    "supabase:reset-all-remote": "node scripts/reset-all-data.js --linked",
    "test:db": "supabase test db",
    "test:functions": "deno test --allow-env --allow-net --config supabase/functions/deno.json supabase/functions/",
    "test": "run-s test:db test:functions",
    "format": "prettier --write \"**/*.{ts,tsx,js}\""
  },
  "dependencies": {
    "@effect/cluster": "^0.58.2",
    "@effect/experimental": "^0.60.0",
    "@effect/rpc": "^0.75.1",
    "@effect/sql": "^0.51.1",
    "@effect/typeclass": "^0.40.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.46.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.7",
    "@babel/core": "^7.24.0",
    "@types/react": "^19.2.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "supabase": "^2.98.0",
    "typescript": "~6.0.3"
  }
}
